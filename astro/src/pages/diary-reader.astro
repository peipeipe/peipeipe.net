---
import { buildDayTimeline } from "@/lib/reader-timeline.mjs";
import ScreenTimeDay from "@/components/ScreenTimeDay.astro";
import { getScreenTime } from "@/lib/screentime.mjs";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDistance, formatDuration, getActivities } from "@/lib/activity";
import { getPlaces } from "@/lib/checkins";
import { datePartsInTokyo, formatEntryDate, getDiaryEntries } from "@/lib/content";

const screenTime = getScreenTime();
const screenTimeByDate = new Map(screenTime.map((record) => [record.date, record]));
const activities = getActivities();
const checkins = getPlaces();
const activitiesByDate = groupByDate(activities, (activity) => dateIdInTokyo(activity.start_date));
const checkinsByDate = groupByDate(checkins, (place) => dateIdInTokyo(place.last_checkin_at) || place.date || "");

const diaryEntries = await getDiaryEntries();
const diaryByDate = new Map(diaryEntries.map((entry) => [formatEntryDate(entry.date), entry]));
const dateIds = [...new Set([...diaryByDate.keys(), ...activitiesByDate.keys(), ...checkinsByDate.keys(), ...screenTimeByDate.keys()])]
  .sort((a, b) => b.localeCompare(a));

const entries = dateIds.map((dateId) => {
  const diary = diaryByDate.get(dateId);
  const date = diary?.date || dateFromId(dateId);
  return {
    date,
    dateId,
    title: diary?.title || formatTimelineDate(date),
    url: diary?.url || "",
    records: buildDayTimeline(
      dateId,
      diary ? addLazyLoading(diary.html) : "",
      activitiesByDate.get(dateId) || [],
      checkinsByDate.get(dateId) || [],
    ),
    hasDiary: Boolean(diary),
    photo: diaryPhoto(diary?.html || "") || (checkinsByDate.get(dateId) || []).flatMap(place => place.photos)[0],
    screenTime: screenTimeByDate.get(dateId),
  };
});

const months = [];

for (const entry of entries) {
  const parts = datePartsInTokyo(entry.date);
  const key = `${parts.year}-${parts.month}`;
  const lastMonth = months.at(-1);

  if (lastMonth?.key === key) {
    lastMonth.entries.push(entry);
  } else {
    months.push({
      key,
      year: parts.year,
      label: `${parts.year}年${Number(parts.month)}月`,
      shortLabel: `${Number(parts.month)}月`,
      entries: [entry],
    });
  }
}

const years = [];

for (const month of months) {
  const lastYear = years.at(-1);
  if (lastYear?.year === month.year) {
    lastYear.months.push(month);
  } else {
    years.push({ year: month.year, months: [month] });
  }
}

function diaryPhoto(html) {
  const content = html.replace(/<a\b(?=[^>]*\bclass="[^"]*\blink-card\b[^"]*")[\s\S]*?<\/a>/g, "");
  return [...content.matchAll(/<img\s[^>]*src="([^"]+)"/g)].at(-1)?.[1];
}

function calendarWeeks(month) {
  const [year, monthNumber] = month.key.split("-").map(Number);
  const offset = new Date(Date.UTC(year, monthNumber - 1, 1)).getUTCDay();
  const days = new Date(Date.UTC(year, monthNumber, 0)).getUTCDate();
  const byDate = new Map(month.entries.map(entry => [entry.dateId, entry]));
  return Array.from({ length: Math.ceil((offset + days) / 7) }, (_, week) =>
    Array.from({ length: 7 }, (_, weekday) => {
      const day = week * 7 + weekday - offset + 1;
      const dateId = `${month.key}-${String(day).padStart(2, "0")}`;
      return day < 1 || day > days ? null : { day, dateId, entry: byDate.get(dateId) };
    }));
}

function addLazyLoading(html) {
  return html.replace(/<img\b(?![^>]*\bloading=)/g, '<img loading="lazy" decoding="async"');
}

function dateIdInTokyo(value) {
  if (!value) return "";
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? "" : formatEntryDate(date);
}

function dateFromId(dateId) {
  return new Date(`${dateId}T12:00:00+09:00`);
}

function formatTimelineDate(date) {
  return new Intl.DateTimeFormat("ja-JP", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    weekday: "short",
    timeZone: "Asia/Tokyo",
  }).format(date);
}

function groupByDate(items, getDate) {
  const grouped = new Map();
  for (const item of items) {
    const date = getDate(item);
    if (!date) continue;
    grouped.set(date, [...(grouped.get(date) || []), item]);
  }
  return grouped;
}

const activityIcon = (type) => ({
  run: "🏃",
  ride: "🚴",
  walk: "🚶",
  swim: "🏊",
  other: "●",
})[type] || "●";

const activityLabel = (type) => ({
  run: "Run",
  ride: "Ride",
  walk: "Walk",
  swim: "Swim",
  other: "Activity",
})[type] || "Activity";
---

<BaseLayout
  title="日記リーダー"
  description="日記、チェックイン、アクティビティを時系列で続けて読むためのページ"
  robots="noindex, nofollow"
  analytics={false}
  wide={true}
>
  <header class="reader-header">
    <div>
      <p class="reader-eyebrow">PERSONAL LOG</p>
      <h1>日記リーダー</h1>
      <p>日記、チェックイン、アクティビティを{entries.length}日分のタイムラインで、日付・時刻とも新しい順に表示しています（日本時間）。</p>
    </div>
    <div class="reader-header-actions">
      <div class="reader-summary" aria-label="収録している記録">
        <a href="/diary/"><strong>{diaryEntries.length}</strong><span>日記</span></a>
        <a href="/activity/"><strong>{activities.length}</strong><span>アクティビティ</span></a>
        <a href="/places/"><strong>{checkins.length}</strong><span>チェックイン</span></a>
        <a href="/screentime/"><strong>{screenTime.length}</strong><span>スクリーンタイム</span></a>
      </div>
      <div class="reader-view-switch" role="group" aria-label="表示方法" hidden>
        <button type="button" data-reader-view="timeline" aria-pressed="true">タイムライン</button>
        <button type="button" data-reader-view="calendar" aria-pressed="false">カレンダー</button>
      </div>
      <button class="reader-log-toggle" type="button" data-log-toggle aria-pressed="true">
        <span class="reader-log-toggle-mark" aria-hidden="true"></span>
        <span data-log-toggle-label>日記のない日も表示</span>
      </button>
    </div>
  </header>

  <div class="reader-layout">
    <nav class="reader-nav" aria-label="年月から日記へ移動">
      <p class="reader-nav-title">年月</p>
      {years.map((year) => (
        <div class="reader-nav-year" data-nav-year={year.year}>
          <a href={`#year-${year.year}`}>{year.year}年</a>
          <div class="reader-nav-months">
            {year.months.map((month) => (
              <a href={`#month-${month.key}`} data-nav-month={month.key}>{month.shortLabel}</a>
            ))}
          </div>
        </div>
      ))}
    </nav>

    <div class="reader-content">
      {years.map((year) => (
        <section class="reader-year" aria-labelledby={`year-${year.year}`} data-reader-year={year.year}>
          <h2 id={`year-${year.year}`}>{year.year}年</h2>
          {year.months.map((month) => (
            <section class="reader-month" aria-labelledby={`month-${month.key}`} data-reader-month={month.key}>
              <h3 id={`month-${month.key}`}>{month.label}</h3>
              <table class="reader-calendar" data-calendar hidden aria-label={`${month.label}の記録カレンダー`}>
                <thead><tr>{["日", "月", "火", "水", "木", "金", "土"].map(day => <th scope="col">{day}</th>)}</tr></thead>
                <tbody>{calendarWeeks(month).map(week => <tr>{week.map(cell => (
                  <td>{cell && <>
                    {cell.entry && <a href={`#entry-${cell.dateId}`} data-calendar-entry data-activity-only={!cell.entry.hasDiary ? "true" : undefined} class:list={["reader-calendar-day", { "with-photo": cell.entry.photo }]} aria-label={`${cell.dateId}の記録を読む`}>
                      {cell.entry.photo && <img src={cell.entry.photo} alt="" loading="lazy" />}
                      <time datetime={cell.dateId}>{cell.day}</time>
                      <span class="calendar-mark" aria-hidden="true">{cell.entry.hasDiary ? "●" : "○"}</span>
                    </a>}
                    <div class="reader-calendar-day calendar-empty" data-calendar-empty={cell.entry && !cell.entry.hasDiary ? "true" : undefined} hidden={Boolean(cell.entry)}><time datetime={cell.dateId}>{cell.day}</time></div>
                  </>}</td>
                ))}</tr>)}</tbody>
              </table>
              <div data-timeline>
              {month.entries.map((entry) => (
                <article class:list={["diary-entry", "diary-reader-entry", { "reader-entry-without-diary": !entry.hasDiary }]} id={`entry-${entry.dateId}`}>
                  <header class="diary-header reader-entry-header">
                    <h4 class="diary-date">
                      {entry.url ? <a href={entry.url}>{entry.title}</a> : entry.title}
                    </h4>
                    {!entry.hasDiary && <span class="reader-entry-label">行動記録</span>}
                  </header>
                  {entry.screenTime && <ScreenTimeDay record={entry.screenTime} />}
                  <div class="reader-day-layout">
                    {entry.records.map((record) => {
                      if (record.kind === "diary") {
                        return <div class="diary-content" data-record-time={record.datetime} set:html={record.value} />;
                      }
                      const activity = record.kind === "activity" ? record.value : null;
                      const place = record.kind === "checkin" ? record.value : null;
                      return (
                        <div class="diary-content reader-records" data-record-time={record.datetime}>
                          <section class="diary-block reader-record">
                            <h5 class="reader-record-heading">
                              {record.datetime ? <time datetime={record.datetime}>{record.time}</time> : record.time}
                              {" · "}
                              <span aria-hidden="true">{activity ? activityIcon(activity.type_class) : "📍"}</span>{" "}
                              {activity ? `アクティビティ · ${activityLabel(activity.type_class)}` : "チェックイン"}
                              {place?.categories.length > 0 && ` · ${place.categories.join("、")}`}
                            </h5>
                            {activity && (
                              <>
                                <p class="reader-record-name">
                                  <a href={activity.url}>{activity.name}</a>
                                </p>
                                <p class="reader-record-meta">
                                  {formatDistance(activity.distance)} · {formatDuration(activity.moving_time)}
                                  {activity.total_elevation_gain > 0 && ` · 獲得標高 ${Math.round(activity.total_elevation_gain)} m`}
                                </p>
                              </>
                            )}
                            {place && (
                              <>
                                <p class="reader-record-name">
                                  <a href={place.foursquare_url || "/places/"}>{place.name}</a>
                                </p>
                                {place.user_comment && <p class="reader-record-comment">{place.user_comment}</p>}
                                {place.address && <p class="reader-record-meta">{place.address}</p>}
                                {place.photos.map((photo) => (
                                  <img src={photo} alt={`${place.name}の写真`} loading="lazy" decoding="async" />
                                ))}
                              </>
                            )}
                          </section>
                        </div>
                      );
                    })}
                  </div>
                </article>
              ))}
              </div>
            </section>
          ))}
        </section>
      ))}
    </div>
  </div>

  <script is:inline>
    (() => {
      const storageKey = "diary-reader-show-activity-log";
      const toggle = document.querySelector("[data-log-toggle]");
      const label = document.querySelector("[data-log-toggle-label]");
      if (!toggle || !label) return;

      let showActivityLog = true;
      try {
        showActivityLog = localStorage.getItem(storageKey) !== "false";
      } catch {}

      let view = "timeline";
      try { if (localStorage.getItem("diary-reader-view") === "calendar") view = "calendar"; } catch {}
      const viewSwitch = document.querySelector(".reader-view-switch");
      viewSwitch.hidden = false;
      const updateView = () => {
        document.querySelectorAll("[data-reader-view]").forEach(button => button.setAttribute("aria-pressed", String(button.dataset.readerView === view)));
        document.querySelectorAll("[data-calendar]").forEach(panel => { panel.hidden = view !== "calendar"; });
        document.querySelectorAll("[data-timeline]").forEach(panel => { panel.hidden = view === "calendar"; });
      };
      viewSwitch.addEventListener("click", event => {
        const button = event.target.closest("[data-reader-view]");
        if (!button) return;
        view = button.dataset.readerView;
        if (view === "calendar" && location.hash.startsWith("#entry-")) history.replaceState(null, "", location.pathname + location.search);
        try { localStorage.setItem("diary-reader-view", view); } catch {}
        updateView();
      });
      const openEntry = () => {
        if (!location.hash.startsWith("#entry-")) return;
        const entry = document.getElementById(location.hash.slice(1));
        if (!entry) return;
        view = "timeline";
        if (entry.classList.contains("reader-entry-without-diary")) showActivityLog = true;
        update();
        updateView();
        entry.setAttribute("tabindex", "-1");
        entry.focus({ preventScroll: true });
        entry.scrollIntoView({ block: "start" });
      };
      document.querySelectorAll("[data-calendar-entry]").forEach(link => link.addEventListener("click", () => {
        view = "timeline";
        updateView();
      }));
      window.addEventListener("hashchange", openEntry);

      const update = () => {
        document.querySelectorAll("[data-activity-only]").forEach(link => { link.hidden = !showActivityLog; });
        document.querySelectorAll("[data-calendar-empty]").forEach(cell => { cell.hidden = showActivityLog; });
        document.querySelectorAll(".reader-entry-without-diary").forEach((entry) => {
          entry.hidden = !showActivityLog;
        });

        document.querySelectorAll("[data-reader-month]").forEach((month) => {
          const hasVisibleEntry = Array.from(month.querySelectorAll(".diary-reader-entry"))
            .some((entry) => !entry.hidden);
          month.hidden = !hasVisibleEntry;
          const monthKey = month.dataset.readerMonth;
          const navLink = document.querySelector(`[data-nav-month="${monthKey}"]`);
          if (navLink) navLink.hidden = !hasVisibleEntry;
        });

        document.querySelectorAll("[data-reader-year]").forEach((year) => {
          const hasVisibleMonth = Array.from(year.querySelectorAll(".reader-month"))
            .some((month) => !month.hidden);
          year.hidden = !hasVisibleMonth;
          const yearKey = year.dataset.readerYear;
          const navYear = document.querySelector(`[data-nav-year="${yearKey}"]`);
          if (navYear) navYear.hidden = !hasVisibleMonth;
        });

        toggle.setAttribute("aria-pressed", String(showActivityLog));
        label.textContent = "日記のない日も表示";
      };

      toggle.addEventListener("click", () => {
        showActivityLog = !showActivityLog;
        try {
          localStorage.setItem(storageKey, String(showActivityLog));
        } catch {}
        update();
      });

      update();
      updateView();
      openEntry();
    })();
  </script>

  <div class="diary-lightbox" id="diary-lightbox" role="dialog" aria-modal="true" aria-hidden="true">
    <button type="button" class="diary-lightbox-close" aria-label="閉じる">✕</button>
    <img src="" alt="" />
  </div>

  <script is:inline>
    (() => {
      const contents = document.querySelectorAll(".diary-content");
      const lightbox = document.getElementById("diary-lightbox");
      if (!contents.length || !lightbox) return;

      document.body.classList.add("js-diary");
      const lightboxImage = lightbox.querySelector("img");
      const closeButton = lightbox.querySelector(".diary-lightbox-close");

      const closeLightbox = () => {
        lightbox.classList.remove("open");
        lightbox.setAttribute("aria-hidden", "true");
        document.body.classList.remove("diary-lightbox-open");
        lightboxImage.src = "";
      };

      contents.forEach((content) => {
        let currentBlock;
        Array.from(content.children).forEach((element) => {
          if (element.tagName === "H2") {
            currentBlock = document.createElement("div");
            currentBlock.className = "diary-block";
            content.insertBefore(currentBlock, element);
          }
          if (currentBlock) currentBlock.appendChild(element);
        });

        content.querySelectorAll("img").forEach((image) => {
          if (image.closest(".link-card-media") || image.closest(".krb-amzlt-image")) return;
          image.classList.add("diary-content-image");
          image.addEventListener("click", () => {
            lightboxImage.src = image.currentSrc || image.src;
            lightboxImage.alt = image.alt || "";
            lightbox.classList.add("open");
            lightbox.setAttribute("aria-hidden", "false");
            document.body.classList.add("diary-lightbox-open");
          });
        });
      });

      lightbox.addEventListener("click", (event) => {
        if (event.target === lightbox || event.target === closeButton || event.target === lightboxImage) {
          closeLightbox();
        }
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && lightbox.classList.contains("open")) closeLightbox();
      });
    })();
  </script>

  <style>
    [hidden] { display: none !important; }
    .reader-view-switch { display: flex; gap: 6px; }
    .reader-view-switch button { padding: 7px 12px; font: inherit; font-size: 13px; color: var(--color-muted); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 6px; cursor: pointer; }
    .reader-view-switch button[aria-pressed="true"] { color: var(--color-link); border-color: var(--color-link); background: var(--color-surface-muted); }
    .reader-calendar { width: 100%; table-layout: fixed; border-collapse: separate; border-spacing: 4px; }
    .reader-calendar th { padding: 4px 0; border: 0; background: transparent; text-align: center; font-size: 12px; color: var(--color-muted); }
    .reader-calendar td { padding: 0; border: 0; }
    .reader-calendar-day { position: relative; display: block; aspect-ratio: 1; min-height: 44px; overflow: hidden; border-radius: 6px; background: var(--color-surface-muted); }
    a.reader-calendar-day { box-shadow: inset 0 0 0 1px var(--color-border); }
    .reader-calendar-day img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .reader-calendar-day time { position: absolute; top: 4px; left: 4px; font-size: 13px; padding: 0 4px; }
    .with-photo time { background: rgba(0, 0, 0, .65); color: #fff; border-radius: 3px; }
    .calendar-empty { background: var(--color-surface-soft); color: var(--color-subtle); }
    .calendar-mark { position: absolute; right: 5px; bottom: 3px; font-size: 10px; }
    .with-photo .calendar-mark { color: #fff; text-shadow: 0 1px 3px #000; }
    .reader-view-switch button:focus-visible, a.reader-calendar-day:focus-visible { outline: 3px solid var(--color-link); outline-offset: 2px; }
    @media (max-width: 480px) {
      .reader-calendar { border-spacing: 2px; }
      .reader-calendar-day time { top: 2px; left: 2px; font-size: 12px; padding: 0 3px; }
    }

    .reader-header {
      width: 100%;
      max-width: 1158px;
      margin: 0 auto 28px;
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 28px;
    }

    .reader-header h1 {
      margin: 0 0 6px;
    }

    .reader-header p {
      margin: 0;
      color: var(--color-muted);
    }

    .reader-header .reader-eyebrow {
      margin-bottom: 3px;
      color: #df633f;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.16em;
    }

    .reader-summary {
      display: flex;
      flex: none;
      overflow: hidden;
      border: 1px solid var(--color-border-soft);
      border-radius: 10px;
      background: var(--color-surface-muted);
    }

    .reader-header-actions {
      display: grid;
      justify-items: end;
      gap: 9px;
    }

    .reader-log-toggle {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      border: 0;
      background: transparent;
      padding: 2px;
      color: var(--color-muted);
      font: inherit;
      font-size: 12px;
      cursor: pointer;
    }

    .reader-log-toggle-mark {
      position: relative;
      width: 28px;
      height: 16px;
      border: 1px solid var(--color-border);
      border-radius: 999px;
      background: var(--color-surface-muted);
      transition: background-color 0.15s ease;
    }

    .reader-log-toggle-mark::after {
      position: absolute;
      top: 2px;
      left: 2px;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--color-muted);
      content: "";
      transition: transform 0.15s ease, background-color 0.15s ease;
    }

    .reader-log-toggle[aria-pressed="true"] .reader-log-toggle-mark {
      border-color: #4776d0;
      background: #4776d0;
    }

    .reader-log-toggle[aria-pressed="true"] .reader-log-toggle-mark::after {
      background: #fff;
      transform: translateX(12px);
    }

    .reader-log-toggle:focus-visible {
      outline: 2px solid #4776d0;
      outline-offset: 3px;
      border-radius: 3px;
    }

    .reader-summary a {
      min-width: 78px;
      padding: 10px 13px;
      color: inherit;
      text-align: center;
      text-decoration: none;
    }

    .reader-summary a + a {
      border-left: 1px solid var(--color-border-soft);
    }

    .reader-summary strong,
    .reader-summary span {
      display: block;
    }

    .reader-summary strong {
      font-size: 17px;
      line-height: 1.2;
    }

    .reader-summary span {
      margin-top: 2px;
      color: var(--color-muted);
      font-size: 10px;
      letter-spacing: 0.04em;
    }

    .reader-layout {
      display: grid;
      grid-template-columns: minmax(150px, 190px) minmax(0, 920px);
      gap: 48px;
      align-items: start;
      justify-content: center;
    }

    .reader-nav {
      position: sticky;
      top: 20px;
      max-height: calc(100vh - 40px);
      overflow-y: auto;
      border: 1px solid var(--color-border-soft);
      border-radius: 8px;
      background: var(--color-surface-muted);
      padding: 14px;
      font-size: 14px;
    }

    .reader-nav-title {
      margin: 0 0 10px;
      font-weight: bold;
    }

    .reader-nav-year + .reader-nav-year {
      margin-top: 12px;
    }

    .reader-nav-year > a {
      font-weight: bold;
    }

    .reader-nav-months {
      display: flex;
      flex-wrap: wrap;
      gap: 5px 10px;
      margin-top: 5px;
    }

    .reader-content {
      min-width: 0;
    }

    .reader-year > h2,
    .reader-month > h3 {
      scroll-margin-top: 20px;
    }

    .reader-year > h2 {
      margin: 0 0 24px;
      border-bottom: 2px solid var(--color-border);
      padding-bottom: 8px;
    }

    .reader-year + .reader-year {
      margin-top: 64px;
    }

    .reader-month > h3 {
      margin: 40px 0 0;
      color: var(--color-muted);
    }

    .reader-month > h3:first-child {
      margin-top: 0;
    }

    .diary-reader-entry {
      max-width: none;
      scroll-margin-top: 20px;
      border-bottom: 1px solid var(--color-border-soft);
      padding: 30px 0 38px;
    }

    .reader-entry-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 18px;
      padding-bottom: 12px;
    }

    .reader-entry-header h4 {
      margin: 0;
      font-size: 1.5em;
    }

    .reader-entry-label {
      flex: none;
      color: var(--color-muted);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.12em;
