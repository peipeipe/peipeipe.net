---
import MapLayout from "@/layouts/MapLayout.astro";
import { getOnsenPlaces, summarizePlaces, type CheckinPlace } from "@/lib/checkins";
import {
  formatMgKg,
  formatTemp,
  getCompositionMap,
  getOnsenCompositions,
  layoutScatterPoints,
  phToX,
  qualityBreakdown,
  scatterPlotHeight,
  scatterPoints,
  SCATTER_CHART,
  SCATTER_PH_TICKS,
  SCATTER_TOTAL_TICKS,
  summarizeCompositions,
  totalToY,
  TREATMENT_LABELS,
  type CompositionIngredient,
  type OnsenSpring,
} from "@/lib/composition";

const places = getOnsenPlaces();
const stats = summarizePlaces(places);
const recentPlaces = places.slice(0, 60);

const compositions = getOnsenCompositions();
const compositionMap = getCompositionMap();
const compositionStats = summarizeCompositions(compositions);
const qualities = qualityBreakdown(compositions);

const googleMapsUrl = (place: CheckinPlace) => {
  const lat = Number(place.lat);
  const lng = Number(place.lng);
  const coordinates = Number.isFinite(lat) && Number.isFinite(lng) ? `${lat},${lng}` : "";
  const query = [place.name, coordinates].filter(Boolean).join(" ");
  return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
};

// 掲示から拾えた指標だけをバッジにする
const compositionBadges = (entry: OnsenSpring) =>
  [
    typeof entry.source_temp_c === "number" ? `源泉 ${formatTemp(entry.source_temp_c)}` : "",
    typeof entry.ph === "number" ? `pH ${entry.ph}` : "",
    typeof entry.total_ingredients_mg_kg === "number" ? `成分総計 ${formatMgKg(entry.total_ingredients_mg_kg)}` : "",
  ].filter(Boolean);

const ingredientGroups = (entry: OnsenSpring) =>
  [
    { label: "陽イオン", items: entry.cations, total: entry.cations_total_mg_kg },
    { label: "陰イオン", items: entry.anions, total: entry.anions_total_mg_kg },
    { label: "非解離成分", items: entry.undissociated, total: entry.undissociated_total_mg_kg },
    { label: "溶存ガス", items: entry.dissolved_gas, total: entry.dissolved_gas_total_mg_kg },
  ].filter((group) => (group.items?.length || 0) > 0) as {
    label: string;
    items: CompositionIngredient[];
    total?: number | null;
  }[];

const treatmentEntries = (entry: OnsenSpring) =>
  TREATMENT_LABELS.map(({ key, label }) => ({ label, value: entry.treatment?.[key] })).filter(
    (item) => item.value && typeof item.value.applied === "boolean",
  );

// 写真の読み取り精度と、ネット由来なら出典の一次性。どちらもデータの確からしさを指す
const confidenceLabel: Record<string, string> = {
  high: "",
  medium: "確度: 中",
  low: "確度: 低",
};

const joinedQualities = (springs: OnsenSpring[]) =>
  [...new Set(springs.map((spring) => spring.spring_quality).filter(Boolean))].join("／");

// --- pH × 成分総計の散布図（配置の計算は lib/composition.ts 側） ---
const CHART = SCATTER_CHART;
const plotWidth = CHART.width - CHART.left - CHART.right;
const plotHeight = scatterPlotHeight;
const phTicks = SCATTER_PH_TICKS;
const totalTicks = SCATTER_TOTAL_TICKS;

const plotted = layoutScatterPoints(scatterPoints(compositions));
const scatterGroups = [...new Map(plotted.map((point) => [point.group.key, point.group])).values()];
---

<MapLayout
  title="温泉マップ"
  description="Foursquare / Swarm のチェックイン履歴から、訪れた温泉とサウナだけをまとめた地図です。"
  canonicalPath="/onsen/"
>
  <section class="map-app checkin-map-app">
    <header class="map-app-header">
      <div>
        <h1>温泉マップ</h1>
        <p>Foursquare / Swarm のチェックイン履歴から、訪れた温泉とサウナだけをまとめた地図です。</p>
      </div>
      <div class="map-app-stats" aria-label="Onsen stats">
        <div>
          <strong data-stat="total-onsen">{stats.count.toLocaleString()}</strong>
          <span>Onsen</span>
        </div>
        <div>
          <strong data-stat="total-checkins">{stats.checkins.toLocaleString()}</strong>
          <span>Check-ins</span>
        </div>
        <div>
          <strong>{stats.withPhotos.toLocaleString()}</strong>
          <span>Photos</span>
        </div>
        <a href="#composition">
          <strong>{compositionStats.count.toLocaleString()}</strong>
          <span>成分表</span>
        </a>
        <div>
          <strong>{stats.latest?.date || ""}</strong>
          <span>Latest</span>
        </div>
      </div>
    </header>

    <div class="map-workspace">
      <section class="map-main-panel" aria-label="Onsen map">
        <div class="map-controlbar">
          <input class="map-search" id="onsen-search" type="search" placeholder="温泉名・住所・コメントで検索" aria-label="温泉検索" />
        </div>
        <div class="map-canvas-wrap">
          <div id="onsen-map" class="map-canvas"></div>
          <div class="map-loading" id="onsen-map-loading">読み込み中...</div>
        </div>
      </section>

      <aside class="map-side-panel" aria-label="Onsen places">
        <div class="panel-header">
          <h2>温泉一覧</h2>
          <span id="onsen-count-badge">{places.length}箇所</span>
        </div>
        <div class="checkin-list compact" id="onsen-list">
          {
            recentPlaces.map((place, index) => (
              <article class="checkin-item" id={`onsen-item-${index}`}>
                {place.photos?.length ? (
                  <button
                    class="checkin-item-photo checkin-item-photo-btn"
                    type="button"
                    data-lightbox-index={index}
                    aria-label={`${place.name}の写真を拡大 (${place.photos.length}枚)`}
                  >
                    <img src={place.photos[0]} alt={`${place.name}の写真`} loading="lazy" />
                    {place.photos.length > 1 && (
                      <span class="checkin-item-photo-count">📷 {place.photos.length}</span>
                    )}
                  </button>
                ) : (
                  <div class="checkin-item-photo checkin-item-photo--empty">
                    <div class="checkin-item-placeholder">♨️</div>
                  </div>
                )}
                <button class="checkin-item-focus" type="button" data-place-index={index}>
                  <div class="checkin-item-body">
                    <div class="checkin-item-heading">
                      <span class="checkin-item-category onsen-category">♨️ 温泉・サウナ</span>
                      <span>{place.date}</span>
                    </div>
                    <h3>{place.name}</h3>
                    {place.fsq_id && compositionMap.has(place.fsq_id) && (
                      <p class="checkin-item-quality">
                        <span class="quality-mark">分析書</span>
                        <span class="quality-text">{joinedQualities(compositionMap.get(place.fsq_id)!)}</span>
                      </p>
                    )}
                    <p class="checkin-item-address">{place.address}</p>
                    {place.user_comment && <p class="checkin-item-comment">{place.user_comment}</p>}
                  </div>
                </button>
                <div class="checkin-item-footer">
                  <span class="checkin-item-meta">{place.checkin_count}回チェックイン</span>
                  <a
                    class="checkin-item-map-link"
                    href={googleMapsUrl(place)}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${place.name}をGoogle Mapsで開く`}
                  >
                    Google Maps ↗
                  </a>
                </div>
              </article>
            ))
          }
        </div>
        <div class="checkin-empty" id="onsen-empty" hidden>表示できる温泉がありません。</div>
      </aside>
    </div>

    <section class="composition-section" id="composition" aria-label="温泉成分表">
      <header class="composition-header">
        <div>
          <h2>温泉成分表</h2>
          <p>
            チェックイン写真に写っていた温泉分析書・成分掲示表と、施設や自治体がネットで公開している分析書・泉質情報を
            まとめたものです。数値は出典の記載そのままで、単位は mg/kg に揃えています。出典は各施設の備考に書いています。
          </p>
        </div>
        <dl class="composition-stats" aria-label="成分表の統計">
          <div>
            <dt>施設</dt>
            <dd>{compositionStats.placeCount}</dd>
          </div>
          <div>
            <dt>源泉</dt>
            <dd>{compositionStats.count}</dd>
          </div>
          {compositionStats.hottest && (
            <div>
              <dt>最高源泉温度</dt>
              <dd>{formatTemp(compositionStats.hottest.source_temp_c)}</dd>
            </div>
          )}
          {compositionStats.mostAlkaline && (
            <div>
              <dt>最高pH</dt>
              <dd>{compositionStats.mostAlkaline.ph}</dd>
            </div>
          )}
          {compositionStats.richest && (
            <div>
              <dt>最高成分総計</dt>
              <dd>{formatMgKg(compositionStats.richest.total_ingredients_mg_kg)}</dd>
            </div>
          )}
        </dl>
      </header>

      {qualities.length > 0 && (
        <ul class="composition-qualities" aria-label="泉質の内訳">
          {qualities.map((item) => (
            <li>
              <span>{item.quality}</span>
              <strong>{item.count}</strong>
            </li>
          ))}
        </ul>
      )}

      <div class="composition-charts">
        <figure class="composition-chart">
          <figcaption>
            <strong>pH と成分総計</strong>
            <span>右へ行くほどアルカリ性、上へ行くほど濃い温泉です（縦軸は対数）。</span>
            <span>点にカーソルを合わせる（タップする）と施設名、クリックで下の成分表へ移動します。</span>
            <span class="scatter-hint">図は横にスワイプできます。</span>
          </figcaption>

          <ul class="scatter-legend">
            {scatterGroups.map((group) => (
              <li>
                <span class={`scatter-swatch quality-${group.key}`} aria-hidden="true"></span>
                {group.label}
              </li>
            ))}
          </ul>

          <div class="scatter-wrap" id="scatter-wrap">
            <svg
              class="scatter-chart"
              viewBox={`0 0 ${CHART.width} ${CHART.height}`}
              role="img"
              aria-label={`pHと成分総計の散布図。${plotted.length}施設をプロットしています。`}
            >
              {totalTicks.map((tick) => (
                <>
                  <line
                    class="scatter-grid"
                    x1={CHART.left}
                    x2={CHART.width - CHART.right}
                    y1={totalToY(tick)}
                    y2={totalToY(tick)}
                  />
                  <text class="scatter-tick" x={CHART.left - 9} y={totalToY(tick) + 4} text-anchor="end">
                    {tick.toLocaleString("ja-JP")}
                  </text>
                </>
              ))}

              {phTicks.map((tick) => (
                <>
                  <line
                    class="scatter-grid"
                    x1={phToX(tick)}
                    x2={phToX(tick)}
                    y1={CHART.top}
                    y2={CHART.top + plotHeight}
                  />
                  <text
                    class="scatter-tick"
                    x={phToX(tick)}
                    y={CHART.top + plotHeight + 20}
                    text-anchor="middle"
                  >
                    pH {tick}
                  </text>
                </>
              ))}

              <text class="scatter-axis" x={CHART.left - 9} y={CHART.top - 4} text-anchor="end">
                mg/kg
              </text>

              {/* ラベル → 点の順に描く。点（＝リンク）を最前面に置いて、
                  ラベルが当たり判定を食わないようにする */}
              {plotted.map((point) =>
                point.showLabel ? (
                  <text class="scatter-label" x={point.labelX} y={point.labelY} text-anchor={point.anchor}>
                    {point.label}
                  </text>
                ) : null,
              )}

              {plotted.map((point) => (
                <a
                  class="scatter-point"
                  href={`#${point.anchorId}`}
                  data-name={point.name}
                  data-quality={point.quality}
                  data-ph={`pH ${point.ph}`}
                  data-total={`成分総計 ${formatMgKg(point.total)}`}
                  aria-label={`${point.name}／${point.quality}／pH ${point.ph}／成分総計 ${formatMgKg(point.total)}`}
                >
                  {/* 指やマウスで狙える大きさの透明な当たり判定（見た目の点は 6px） */}
                  <circle class="scatter-hit" cx={point.x} cy={point.y} r="14" />
                  <circle class={`scatter-ring quality-${point.group.key}`} cx={point.x} cy={point.y} r="10" />
                  <circle class={`scatter-dot quality-${point.group.key}`} cx={point.x} cy={point.y} r="6" />
                </a>
              ))}
            </svg>
          </div>

          {/* 横スクロールする .scatter-wrap の中に置くと切れるので、図の枠側に重ねる */}
          <div class="scatter-tooltip" hidden>
            <strong class="scatter-tooltip-name"></strong>
            <span class="scatter-tooltip-quality"></span>
            <span class="scatter-tooltip-values"></span>
          </div>
        </figure>
      </div>

      <div class="composition-items">
        {compositions.map((entry) => (
          /* 散布図の点からリンクで飛んでくる先 */
          <details
            class="composition-item"
            id={entry.spring_index === 0
              ? `composition-${entry.fsq_id}`
              : `composition-${entry.fsq_id}-spring-${entry.spring_index + 1}`}
          >
            <summary>
              <div class="composition-item-head">
                <h3>{entry.name}</h3>
                {entry.spring_count > 1 && entry.spring_name && (
                  <p class="composition-spring-name">{entry.spring_name}</p>
                )}
                <p class="composition-quality">{entry.spring_quality}</p>
                {entry.spring_quality_class && <p class="composition-quality-class">{entry.spring_quality_class}</p>}
              </div>
              <ul class="composition-badges">
                {compositionBadges(entry).map((badge) => (
                  <li>{badge}</li>
                ))}
              </ul>
            </summary>

            <div class="composition-body">
              <dl class="composition-meta">
                {entry.spring_name && (
                  <div>
                    <dt>源泉名</dt>
                    <dd>{entry.spring_name}</dd>
                  </div>
                )}
                {typeof entry.use_temp_c === "number" && (
                  <div>
                    <dt>使用位置温度</dt>
                    <dd>{formatTemp(entry.use_temp_c)}</dd>
                  </div>
                )}
                {typeof entry.yield_l_min === "number" && (
                  <div>
                    <dt>湧出量</dt>
                    <dd>{entry.yield_l_min} L/分</dd>
                  </div>
                )}
                {typeof entry.dissolved_solids_mg_kg === "number" && (
                  <div>
                    <dt>溶存物質</dt>
                    <dd>{formatMgKg(entry.dissolved_solids_mg_kg)}</dd>
                  </div>
                )}
                {typeof entry.evaporation_residue_mg_kg === "number" && (
                  <div>
                    <dt>蒸発残留物</dt>
                    <dd>{formatMgKg(entry.evaporation_residue_mg_kg)}</dd>
                  </div>
                )}
              </dl>

              {treatmentEntries(entry).length > 0 && (
                <ul class="composition-treatment" aria-label="加水・加温・循環・消毒">
                  {treatmentEntries(entry).map((item) => (
                    <li class={item.value!.applied ? "is-applied" : "is-none"}>
                      <span>{item.label}</span>
                      <strong>{item.value!.applied ? "あり" : "なし"}</strong>
                      {item.value!.reason && <em>{item.value!.reason}</em>}
                    </li>
                  ))}
                </ul>
              )}

              {ingredientGroups(entry).length > 0 && (
                <div class="composition-tables">
                  {ingredientGroups(entry).map((group) => (
                    <table class="composition-table">
                      <caption>
                        {group.label}
                        {typeof group.total === "number" && <span>計 {formatMgKg(group.total)}</span>}
                      </caption>
                      <tbody>
                        {group.items.map((item) => (
                          <tr>
                            <th scope="row">
                              {item.name}
                              {item.symbol && <span class="composition-symbol">{item.symbol}</span>}
                            </th>
                            <td>{typeof item.mg_kg === "number" ? item.mg_kg.toLocaleString("ja-JP") : "—"}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  ))}
                </div>
              )}

              {(entry.indications?.length || entry.contraindications?.length) && (
                <div class="composition-symptoms">
                  {entry.indications?.length ? (
                    <p>
                      <span class="composition-symptom-label">泉質別適応症</span>
                      {entry.indications.join("、")}
                    </p>
                  ) : null}
                  {entry.contraindications?.length ? (
                    <p>
                      <span class="composition-symptom-label is-warn">泉質別禁忌症</span>
                      {entry.contraindications.join("、")}
                    </p>
                  ) : null}
                </div>
              )}

              {entry.notes && <p class="composition-notes">{entry.notes}</p>}

              <p class="composition-source">
                {entry.analyzed_on && <span>分析 {entry.analyzed_on}</span>}
                {entry.analyzer && <span>{entry.analyzer}</span>}
                {entry.analyzer_registration && <span>{entry.analyzer_registration}</span>}
                {entry.confidence && confidenceLabel[entry.confidence] && (
                  <span class="composition-confidence">{confidenceLabel[entry.confidence]}</span>
                )}
              </p>
            </div>
          </details>
        ))}
      </div>
    </section>
  </section>

  <div class="photo-lightbox" id="onsen-lightbox" role="dialog" aria-modal="true" aria-hidden="true">
    <button type="button" class="photo-lightbox-close" aria-label="閉じる">✕</button>
    <button type="button" class="photo-lightbox-nav prev" aria-label="前の写真" hidden>‹</button>
    <figure class="photo-lightbox-figure">
      <img src="" alt="" />
      <figcaption class="photo-lightbox-counter" hidden></figcaption>
    </figure>
    <button type="button" class="photo-lightbox-nav next" aria-label="次の写真" hidden>›</button>
  </div>

  <script is:inline>
    const DATA_URL = "/onsen-data.json";
    const LIST_LIMIT = 80;
    let placesData = [];
    let compositionByFsqId = {};
    let map;
    let markerLayer;
    let canvasRenderer;
    let markersByIndex = {};
    let currentSearch = "";
    let searchTimer = null;

    function searchableText(place) {
      const composition = compositionByFsqId[place.fsq_id];
      return [
        place.name,
        place.address,
        place.user_comment,
        (place.categories || []).join(" "),
        composition ? composition.quality : "",
        composition ? composition.qualityClass : "",
      ]
        .join(" ")
        .toLowerCase();
    }

    function filteredPlaces() {
      return placesData.filter((place) => {
        if (!Number.isFinite(place.lat) || !Number.isFinite(place.lng)) return false;
        if (!currentSearch) return true;
        return place._searchText.includes(currentSearch);
      });
    }

    function markerRadius(place) {
      const count = Number(place.checkin_count) || 1;
      return Math.min(10, 5 + Math.log2(count + 1));
    }

    function googleMapsUrl(place) {
      const lat = Number(place.lat);
      const lng = Number(place.lng);
      const coordinates = Number.isFinite(lat) && Number.isFinite(lng) ? `${lat},${lng}` : "";
      const query = [place.name, coordinates].filter(Boolean).join(" ");
      return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
    }

    function render() {
      const filtered = filteredPlaces();
      updateStats(filtered);
      renderMarkers(filtered);
      renderList(filtered);
      document.getElementById("onsen-empty").hidden = filtered.length > 0;
    }

    function updateStats(filtered) {
      document.querySelector('[data-stat="total-onsen"]').textContent = filtered.length.toLocaleString();
      document.querySelector('[data-stat="total-checkins"]').textContent = filtered
        .reduce((sum, place) => sum + (Number(place.checkin_count) || 0), 0)
        .toLocaleString();
      document.getElementById("onsen-count-badge").textContent = `${filtered.length.toLocaleString()}箇所`;
    }

    function renderMarkers(filtered) {
      markerLayer.clearLayers();
      markersByIndex = {};
      const bounds = [];

      filtered.forEach((place) => {
        const marker = L.circleMarker([place.lat, place.lng], {
          renderer: canvasRenderer,
          radius: markerRadius(place),
          fillColor: "#ff7a59",
          fillOpacity: 0.78,
          color: "#ffffff",
          weight: 1,
          opacity: 0.94,
        }).addTo(markerLayer);

        marker.bindPopup(popupHtml(place), { maxWidth: 270, className: "custom-leaflet-popup" });
        marker.on("click", () => highlightPlace(place._index));
        markersByIndex[place._index] = marker;
        bounds.push([place.lat, place.lng]);
      });

      if (bounds.length > 1) map.fitBounds(bounds, { padding: [45, 45], maxZoom: 14 });
      else if (bounds.length === 1) map.setView(bounds[0], 14);
    }

    function renderList(filtered) {
      const list = document.getElementById("onsen-list");
      const visible = filtered.slice(0, LIST_LIMIT);
      list.innerHTML = visible
        .map((place) => {
          const photoCount = (place.photos && place.photos.length) || 0;
          const photoCell = photoCount
            ? `<button class="checkin-item-photo checkin-item-photo-btn" type="button" data-lightbox-index="${place._index}" aria-label="${escapeHtml(place.name || "")}の写真を拡大 (${photoCount}枚)"><img src="${escapeHtml(place.photos[0])}" alt="${escapeHtml(place.name || "")}の写真" loading="lazy">${photoCount > 1 ? `<span class="checkin-item-photo-count">📷 ${photoCount}</span>` : ""}</button>`
            : '<div class="checkin-item-photo checkin-item-photo--empty"><div class="checkin-item-placeholder">♨️</div></div>';
          const comment = place.user_comment ? `<p class="checkin-item-comment">${escapeHtml(place.user_comment)}</p>` : "";
          const quality = compositionByFsqId[place.fsq_id];
          const qualityBlock = quality && quality.quality
            ? `<p class="checkin-item-quality"><span class="quality-mark">分析書</span><span class="quality-text">${escapeHtml(quality.quality)}</span></p>`
            : "";
          const mapsUrl = googleMapsUrl(place);
          return `
            <article class="checkin-item" id="onsen-item-${place._index}">
              ${photoCell}
              <button class="checkin-item-focus" type="button" data-place-index="${place._index}">
                <div class="checkin-item-body">
                  <div class="checkin-item-heading">
                    <span class="checkin-item-category onsen-category">♨️ 温泉・サウナ</span>
                    <span>${escapeHtml(place.date || "")}</span>
                  </div>
                  <h3>${escapeHtml(place.name || "")}</h3>
                  ${qualityBlock}
                  <p class="checkin-item-address">${escapeHtml(place.address || "")}</p>
                  ${comment}
                </div>
              </button>
              <div class="checkin-item-footer">
                <span class="checkin-item-meta">${Number(place.checkin_count) || 1}回チェックイン</span>
                <a class="checkin-item-map-link" href="${escapeHtml(mapsUrl)}" target="_blank" rel="noopener noreferrer" aria-label="${escapeHtml(place.name || "")}をGoogle Mapsで開く">Google Maps ↗</a>
              </div>
            </article>
          `;
        })
        .join("");

      list.querySelectorAll("[data-place-index]").forEach((button) => {
        button.addEventListener("click", () => focusPlace(Number(button.dataset.placeIndex)));
      });

      if (filtered.length > visible.length) {
        list.insertAdjacentHTML("beforeend", `<p class="checkin-list-note">先頭 ${visible.length} 件を表示しています。検索で絞り込めます。</p>`);
      }
    }

    function focusPlace(index) {
      const place = placesData[index];
      if (!place) return;
      map.setView([place.lat, place.lng], 15, { animate: true, duration: 0.8 });
      if (markersByIndex[index]) setTimeout(() => markersByIndex[index].openPopup(), 250);
      highlightPlace(index);
    }

    function highlightPlace(index) {
      document.querySelectorAll(".checkin-item").forEach((item) => item.classList.remove("active"));
      const target = document.getElementById(`onsen-item-${index}`);
      if (target) {
        target.classList.add("active");
      }
    }

    function popupHtml(place) {
      const photoCount = (place.photos && place.photos.length) || 0;
      const photoBlock = photoCount
        ? `<button class="popup-image" type="button" data-lightbox-index="${place._index}" aria-label="${escapeHtml(place.name || "")}の写真を拡大 (${photoCount}枚)"><img src="${escapeHtml(place.photos[0])}" alt="${escapeHtml(place.name || "")}">${photoCount > 1 ? `<span class="popup-image-count">📷 ${photoCount}</span>` : ""}</button>`
        : "";
      const commentBlock = place.user_comment ? `<div class="popup-comment">"${escapeHtml(place.user_comment)}"</div>` : "";
      const dateBlock = place.date ? `<div class="popup-date">📅 ${escapeHtml(place.date)} 訪問</div>` : "";
      const mapsBlock = `<a class="popup-map-link" href="${escapeHtml(googleMapsUrl(place))}" target="_blank" rel="noopener noreferrer">Google Mapsで開く</a>`;
      return `<div class="map-popup-content">${photoBlock}<h4 class="popup-title">♨️ ${escapeHtml(place.name || "")}</h4><p class="popup-address">📍 ${escapeHtml(place.address || "")}</p>${commentBlock}${dateBlock}${mapsBlock}</div>`;
    }

    let lightboxPhotos = [];
    let lightboxIndex = 0;

    // Foursquare の写真 URL は prefix + サイズ + suffix 構造。拡大時は元解像度を使う。
    function highResPhoto(url) {
      if (!url) return "";
      return url.replace(/\/(?:\d+x\d+|original|cap\d+|width\d+|height\d+)\//, "/original/");
    }

    function updateLightbox() {
      const lightbox = document.getElementById("onsen-lightbox");
      const img = lightbox.querySelector("img");
      const counter = lightbox.querySelector(".photo-lightbox-counter");
      const prev = lightbox.querySelector(".photo-lightbox-nav.prev");
      const next = lightbox.querySelector(".photo-lightbox-nav.next");
      const multiple = lightboxPhotos.length > 1;
      img.src = highResPhoto(lightboxPhotos[lightboxIndex]);
      counter.textContent = `${lightboxIndex + 1} / ${lightboxPhotos.length}`;
      counter.hidden = !multiple;
      prev.hidden = !multiple;
      next.hidden = !multiple;
    }

    function openLightbox(photos, start) {
      if (!photos || !photos.length) return;
      lightboxPhotos = photos;
      lightboxIndex = Math.min(Math.max(start || 0, 0), photos.length - 1);
      const lightbox = document.getElementById("onsen-lightbox");
      updateLightbox();
      lightbox.classList.add("open");
      lightbox.setAttribute("aria-hidden", "false");
      document.body.classList.add("photo-lightbox-open");
    }

    function closeLightbox() {
      const lightbox = document.getElementById("onsen-lightbox");
      lightbox.classList.remove("open");
      lightbox.setAttribute("aria-hidden", "true");
      document.body.classList.remove("photo-lightbox-open");
      lightbox.querySelector("img").src = "";
      lightboxPhotos = [];
    }

    function stepLightbox(delta) {
      if (lightboxPhotos.length < 2) return;
      lightboxIndex = (lightboxIndex + delta + lightboxPhotos.length) % lightboxPhotos.length;
      updateLightbox();
    }

    function initLightbox() {
      const lightbox = document.getElementById("onsen-lightbox");
      const img = lightbox.querySelector("img");
      lightbox.querySelector(".photo-lightbox-close").addEventListener("click", closeLightbox);
      lightbox.querySelector(".photo-lightbox-nav.prev").addEventListener("click", (event) => {
        event.stopPropagation();
        stepLightbox(-1);
      });
      lightbox.querySelector(".photo-lightbox-nav.next").addEventListener("click", (event) => {
        event.stopPropagation();
        stepLightbox(1);
      });
      lightbox.addEventListener("click", (event) => {
        if (event.target === lightbox) closeLightbox();
      });
      img.addEventListener("click", (event) => {
        event.stopPropagation();
        if (lightboxPhotos.length > 1) stepLightbox(1);
        else closeLightbox();
      });
      document.addEventListener("keydown", (event) => {
        if (!lightbox.classList.contains("open")) return;
        if (event.key === "Escape") closeLightbox();
        else if (event.key === "ArrowLeft") stepLightbox(-1);
        else if (event.key === "ArrowRight") stepLightbox(1);
      });
      document.addEventListener("click", (event) => {
        const trigger = event.target.closest("[data-lightbox-index]");
        if (!trigger) return;
        event.preventDefault();
        const place = placesData[Number(trigger.dataset.lightboxIndex)];
        if (place) openLightbox(place.photos, 0);
      });
    }

    // --- 散布図：点にカーソル/フォーカスで施設名、クリックで下の成分表へ ---
    function initScatterChart() {
      const figure = document.querySelector(".composition-chart");
      const wrap = document.getElementById("scatter-wrap");
      const tooltip = figure && figure.querySelector(".scatter-tooltip");
      if (!figure || !wrap || !tooltip) return;

      const nameEl = tooltip.querySelector(".scatter-tooltip-name");
      const qualityEl = tooltip.querySelector(".scatter-tooltip-quality");
      const valuesEl = tooltip.querySelector(".scatter-tooltip-values");
      let activePoint = null;

      function position(point) {
        const dot = point.querySelector(".scatter-dot");
        const dotBox = dot.getBoundingClientRect();
        const figureBox = figure.getBoundingClientRect();
        const wrapBox = wrap.getBoundingClientRect();
        const cx = dotBox.left + dotBox.width / 2 - figureBox.left;
        const cy = dotBox.top + dotBox.height / 2 - figureBox.top;

        // 図の見えている範囲からはみ出さないよう左右を寄せる
        const half = tooltip.offsetWidth / 2;
        const min = wrapBox.left - figureBox.left + half;
        const max = wrapBox.right - figureBox.left - half;
        const below = cy - tooltip.offsetHeight - 14 < 0;

        tooltip.classList.toggle("is-below", below);
        tooltip.style.left = `${Math.min(Math.max(cx, min), Math.max(min, max))}px`;
        tooltip.style.top = `${below ? cy + 16 : cy - 14}px`;
      }

      function hideTooltip() {
        activePoint = null;
        tooltip.hidden = true;
        wrap.querySelectorAll(".scatter-point.is-active").forEach((item) => item.classList.remove("is-active"));
      }

      function showTooltip(point) {
        if (activePoint && activePoint !== point) activePoint.classList.remove("is-active");
        activePoint = point;
        point.classList.add("is-active");
        nameEl.textContent = point.dataset.name || "";
        qualityEl.textContent = point.dataset.quality || "";
        qualityEl.hidden = !point.dataset.quality;
        valuesEl.textContent = [point.dataset.ph, point.dataset.total].filter(Boolean).join("　");
        tooltip.hidden = false;
        position(point);
      }

      wrap.querySelectorAll(".scatter-point").forEach((point) => {
        point.addEventListener("pointerenter", () => showTooltip(point));
        point.addEventListener("pointerleave", () => {
          if (activePoint === point) hideTooltip();
        });
        point.addEventListener("focus", () => showTooltip(point));
        point.addEventListener("blur", () => {
          if (activePoint === point) hideTooltip();
        });
        // 同じ点を続けて押すと hashchange が起きないので、ここでも開く処理を呼ぶ
        point.addEventListener("click", () => {
          hideTooltip();
          window.setTimeout(revealCompositionTarget, 0);
        });
      });

      wrap.addEventListener("scroll", () => activePoint && position(activePoint), { passive: true });
      window.addEventListener("resize", () => activePoint && position(activePoint));
    }

    // 散布図から飛んできた #composition-<fsq_id> を開いて見せる
    function revealCompositionTarget() {
      const id = decodeURIComponent((location.hash || "").slice(1));
      if (!id.startsWith("composition-")) return;
      const target = document.getElementById(id);
      if (!target) return;
      document.querySelectorAll(".composition-item.is-target").forEach((item) => item.classList.remove("is-target"));
      target.open = true;
      target.classList.add("is-target");
      target.scrollIntoView({ behavior: "smooth", block: "center" });
    }

    function escapeHtml(value) {
      return String(value == null ? "" : value).replace(/[&<>"']/g, (character) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      })[character]);
    }

    async function loadData() {
      const response = await fetch(DATA_URL);
      if (!response.ok) throw new Error("onsen-data.json load failed");
      const payload = await response.json();
      compositionByFsqId = payload.composition || {};
      placesData = Array.isArray(payload.places) ? payload.places : [];
      placesData.forEach((place, index) => {
        place._index = index;
        place._searchText = searchableText(place);
      });
      document.getElementById("onsen-map-loading").hidden = true;
      render();
    }

    document.addEventListener("DOMContentLoaded", () => {
      initLightbox();
      initScatterChart();
      revealCompositionTarget();
      window.addEventListener("hashchange", revealCompositionTarget);
      const search = document.getElementById("onsen-search");
      search.addEventListener("input", (event) => {
        window.clearTimeout(searchTimer);
        searchTimer = window.setTimeout(() => {
          currentSearch = event.target.value.trim().toLowerCase();
          render();
        }, 160);
      });

      canvasRenderer = L.canvas({ padding: 0.5 });
      map = L.map("onsen-map", {
        preferCanvas: true,
        scrollWheelZoom: false,
        renderer: canvasRenderer,
        zoomControl: true,
      }).setView([36.2048, 138.2529], 5);

      map.on("focus", () => map.scrollWheelZoom.enable());
      map.on("blur", () => map.scrollWheelZoom.disable());
      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      }).addTo(map);
      markerLayer = L.layerGroup().addTo(map);
      requestAnimationFrame(() => map.invalidateSize());
      loadData().catch((error) => {
        console.error(error);
        document.getElementById("onsen-map-loading").textContent = "データの読み込みに失敗しました";
      });
    });
  </script>
</MapLayout>
