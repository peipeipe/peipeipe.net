---
import MapLayout from "@/layouts/MapLayout.astro";
import { getMountainsByLatestVisit, latestMountainActivity, summarizeMountains } from "@/lib/mountains";

const mountains = getMountainsByLatestVisit();
const stats = summarizeMountains(mountains);
const highestElevation = stats.highest ? stats.highest.elevation.toLocaleString() : "0";
const latestVisit = stats.latest?.last_visit || "";
const cartoBasemapsApiKey = import.meta.env.PUBLIC_CARTO_BASEMAPS_API_KEY?.trim() ?? "";
---

<MapLayout
  title="訪問済み山リスト"
  description="Strava の軌跡から山頂付近を通過したアクティビティを自動判定して集計した山リストです。"
  canonicalPath="/mountains/"
  leaflet={false}
>
  <section class="map-app mountains-map-app">
    <header class="map-app-header">
      <div>
        <h1>訪問済み山リスト</h1>
        <p>Strava の軌跡から、山頂付近を通過したアクティビティを自動判定して集計しています。</p>
        <p class="mountains-data-credit">
          山データ: 国土地理院「日本の山岳標高一覧」 /
          <a href="https://www.openstreetmap.org/copyright">© OpenStreetMap contributors</a>
        </p>
      </div>
      <div class="map-app-stats mountains-stats" aria-label="Mountain stats">
        <div>
          <strong data-stat="count">{stats.count}</strong>
          <span>Mountains</span>
        </div>
        <div>
          <strong data-stat="visits">{stats.visits}</strong>
          <span>Visits</span>
        </div>
        <div>
          <strong>{highestElevation}</strong>
          <span>Highest m</span>
        </div>
        <div>
          <strong>{latestVisit}</strong>
          <span>Latest</span>
        </div>
      </div>
    </header>

    <div class="map-workspace">
      <section class="map-main-panel" aria-label="Mountains map">
        <div class="map-controlbar">
          <div class="segmented-control" aria-label="Elevation filter">
            <button class="active" type="button" data-elevation-tier="all">すべて</button>
            <button type="button" data-elevation-tier="2500">2500m+</button>
            <button type="button" data-elevation-tier="2000">2000m+</button>
            <button type="button" data-elevation-tier="1500">1500m+</button>
          </div>
        </div>
        <div class="map-canvas-wrap">
          <div id="mountains-map" class="map-canvas" data-carto-basemaps-api-key={cartoBasemapsApiKey}></div>
          <div class="map-loading" id="mountains-map-loading">読み込み中...</div>
        </div>
      </section>

      <aside class="map-side-panel" aria-label="Visited mountains">
        <div class="panel-header">
          <h2>訪問済み山一覧</h2>
          <span id="mountains-count-badge">{mountains.length}座</span>
        </div>
        <div class="mountain-list compact" id="mountain-list">
          {
            mountains.map((mountain) => {
              const latestActivity = latestMountainActivity(mountain);
              return (
                <article class="mountain-item" data-elevation={mountain.elevation}>
                  <div class="mountain-item-body">
                    <h3>
                      {mountain.name}
                      {mountain.tags.map((tag) => <span class="mountain-tag">{tag}</span>)}
                    </h3>
                    <p>
                      <span>{mountain.elevation.toLocaleString()}m</span>
                      <span>{mountain.visit_count}回訪問</span>
                      <span>初回 {mountain.first_visit}</span>
                    </p>
                    {latestActivity && <p class="mountain-latest">最新 {mountain.last_visit} / {latestActivity.name}</p>}
                  </div>
                </article>
              );
            })
          }
        </div>
      </aside>
    </div>
  </section>

  <script>
    import * as maplibregl from "maplibre-gl";
    import "maplibre-gl/dist/maplibre-gl.css";

    const DATA_URL = "/mountains-data.json";
    const MARKER_SOURCE_ID = "visited-mountains";
    const MARKER_LAYER_ID = "visited-mountain-markers";
    let mountainData = [];
    let currentElevationTier = "all";
    let map;

    function colorForElevation(elevation) {
      if (elevation >= 2500) return "#dc2626";
      if (elevation >= 2000) return "#f97316";
      if (elevation >= 1500) return "#ca8a04";
      return "#15803d";
    }

    function filteredMountains() {
      if (currentElevationTier === "all") return mountainData;
      const minElevation = Number(currentElevationTier);
      return mountainData.filter((mountain) => mountain.elevation >= minElevation);
    }

    function fitMountains(data) {
      if (!data.length || !map) return;
      const bounds = data.reduce(
        (result, mountain) => result.extend([mountain.lng, mountain.lat]),
        new maplibregl.LngLatBounds(),
      );
      map.fitBounds(bounds, { padding: 42, maxZoom: 12 });
    }

    function mountainFeatureCollection(data) {
      return {
        type: "FeatureCollection",
        features: data.map((mountain) => ({
          type: "Feature",
          geometry: {
            type: "Point",
            coordinates: [mountain.lng, mountain.lat],
          },
          properties: {
            name: mountain.name,
            elevation: mountain.elevation,
            visitCount: mountain.visit_count,
            firstVisit: mountain.first_visit,
            lastVisit: mountain.last_visit,
            tags: (mountain.tags || []).join("・"),
          },
        })),
      };
    }

    function renderMarkers(data) {
      if (!map) return;
      const source = map.getSource(MARKER_SOURCE_ID);
      if (!source) return;
      source.setData(mountainFeatureCollection(data));
      fitMountains(data);
    }

    function renderList(data) {
      const list = document.getElementById("mountain-list");
      list.innerHTML = data
        .map((mountain) => {
          const latestActivity = Array.isArray(mountain.activities)
            ? mountain.activities.reduce((current, activity) => (!current || activity.date > current.date ? activity : current), null)
            : null;
          const latest = latestActivity
            ? `<p class="mountain-latest">最新 ${escapeHtml(mountain.last_visit)} / ${escapeHtml(latestActivity.name)}</p>`
            : "";
          const tags = (mountain.tags || [])
            .map((tag) => ` <span class="mountain-tag">${escapeHtml(tag)}</span>`)
            .join("");

          return `
            <article class="mountain-item" data-elevation="${mountain.elevation}">
              <div class="mountain-item-body">
                <h3>${escapeHtml(mountain.name)}${tags}</h3>
                <p>
                  <span>${mountain.elevation.toLocaleString()}m</span>
                  <span>${mountain.visit_count}回訪問</span>
                  <span>初回 ${escapeHtml(mountain.first_visit)}</span>
                </p>
                ${latest}
              </div>
            </article>
          `;
        })
        .join("");
    }

    function updateStats(data) {
      document.querySelector('[data-stat="count"]').textContent = data.length.toLocaleString();
      document.querySelector('[data-stat="visits"]').textContent = data
        .reduce((sum, mountain) => sum + mountain.visit_count, 0)
        .toLocaleString();
      document.getElementById("mountains-count-badge").textContent = `${data.length.toLocaleString()}座`;
    }

    function render() {
      const data = filteredMountains();
      updateStats(data);
      renderList(data);
      renderMarkers(data);
    }

    function setupControls() {
      document.querySelectorAll("[data-elevation-tier]").forEach((button) => {
        button.addEventListener("click", () => {
          document.querySelectorAll("[data-elevation-tier]").forEach((item) => item.classList.remove("active"));
          button.classList.add("active");
          currentElevationTier = button.dataset.elevationTier || "all";
          render();
        });
      });
    }

    function escapeHtml(value) {
      return String(value).replace(/[&<>"']/g, (character) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      })[character]);
    }

    async function loadData() {
      const response = await fetch(DATA_URL);
      if (!response.ok) throw new Error("mountains-data.json load failed");
      const payload = await response.json();
      mountainData = Array.isArray(payload.mountains) ? payload.mountains : [];
      document.getElementById("mountains-map-loading").hidden = true;
      render();
    }

    function setupMountainLayer() {
      map.addSource(MARKER_SOURCE_ID, {
        type: "geojson",
        data: mountainFeatureCollection([]),
      });
      map.addLayer({
        id: MARKER_LAYER_ID,
        type: "circle",
        source: MARKER_SOURCE_ID,
        paint: {
          "circle-radius": 9,
          "circle-color": [
            "step",
            ["get", "elevation"],
            colorForElevation(0),
            1500,
            colorForElevation(1500),
            2000,
            colorForElevation(2000),
            2500,
            colorForElevation(2500),
          ],
          "circle-stroke-color": "#fff",
          "circle-stroke-width": 2,
          "circle-opacity": 0.9,
        },
      });

      map.on("click", MARKER_LAYER_ID, (event) => {
        const feature = event.features?.[0];
        if (!feature) return;
        const properties = feature.properties || {};
        const popupTags = properties.tags ? `${escapeHtml(properties.tags)}<br>` : "";
        new maplibregl.Popup({ maxWidth: "270px" })
          .setLngLat(feature.geometry.coordinates)
          .setHTML(`
            <strong style="font-size:15px">${escapeHtml(properties.name)}</strong><br>
            ${popupTags}
            ${Number(properties.elevation).toLocaleString()}m / ${Number(properties.visitCount).toLocaleString()}回訪問<br>
            初回: ${escapeHtml(properties.firstVisit)}<br>
            最新: ${escapeHtml(properties.lastVisit)}
          `)
          .addTo(map);
      });
      map.on("mouseenter", MARKER_LAYER_ID, () => {
        map.getCanvas().style.cursor = "pointer";
      });
      map.on("mouseleave", MARKER_LAYER_ID, () => {
        map.getCanvas().style.cursor = "";
      });
    }

    document.addEventListener("DOMContentLoaded", () => {
      setupControls();
      const mapElement = document.getElementById("mountains-map");
      const cartoApiKey = mapElement?.dataset.cartoBasemapsApiKey || "";
      const style = cartoApiKey
        ? `https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json?key=${encodeURIComponent(cartoApiKey)}`
        : {
            version: 8,
            sources: {
              "openstreetmap-raster": {
                type: "raster",
                tiles: ["https://tile.openstreetmap.org/{z}/{x}/{y}.png"],
                tileSize: 256,
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
              },
            },
            layers: [{ id: "openstreetmap", type: "raster", source: "openstreetmap-raster" }],
          };

      map = new maplibregl.Map({
        container: mapElement,
        style,
        center: [138.0, 36.2],
        zoom: 7,
        scrollZoom: false,
        attributionControl: false,
      });
      map.addControl(new maplibregl.NavigationControl(), "top-left");
      map.addControl(
        new maplibregl.AttributionControl({
          compact: false,
          customAttribution: cartoApiKey
            ? '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>, &copy; <a href="https://carto.com/attributions">CARTO</a>'
            : undefined,
        }),
      );

      const canvas = map.getCanvas();
      canvas.addEventListener("focus", () => map.scrollZoom.enable());
      canvas.addEventListener("blur", () => map.scrollZoom.disable());

      map.on("load", () => {
        setupMountainLayer();
        loadData().catch((error) => {
          console.error(error);
          document.getElementById("mountains-map-loading").textContent = "データの読み込みに失敗しました";
        });
      });
    });
  </script>
</MapLayout>
