---
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  heat?: boolean;
  leaflet?: boolean;
}

const { title, description, canonicalPath, heat = false, leaflet = true } = Astro.props;
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} wide>
  <Fragment slot="head">
    {
      leaflet && (
        <link
          rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin=""
        />
      )
    }
    {
      leaflet && (
        <script
          is:inline
          src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
          integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
          crossorigin=""
        ></script>
      )
    }
    {leaflet && heat && <script is:inline src="https://unpkg.com/leaflet.heat@0.2.0/dist/leaflet-heat.js"></script>}
    <slot name="head" />
  </Fragment>
  <slot />
</BaseLayout>
