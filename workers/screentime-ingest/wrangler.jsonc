{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "peipeipe-screentime-ingest",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "www.peipeipe.net/api/screentime*", "zone_name": "peipeipe.net" }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
